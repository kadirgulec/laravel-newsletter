{
  "name": "kadirgulec/newsletter",
  "description": "A robust newsletter package for Laravel",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "KadirGulec\\Newsletter\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "KadirGulec\\Newsletter\\Providers\\NewsletterServiceProvider"
      ]
    }
  },
  "require": {
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.0|^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "KadirGulec\\Newsletter\\Tests\\": "tests/"
    }
  }
}